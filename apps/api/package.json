{
  "name": "@dt/api",
  "version": "0.1.0",
  "private": true,
  "description": "Spatial asset, telemetry and BIM API + socket.io realtime gateway (NestJS)",
  "main": "./dist/main.js",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
