# =============================================================================
#  dt-platform — environment template
#  cp .env.example .env  and replace every CHANGE_ME before first start.
#  Generate secrets with:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# =============================================================================

# ---- Global -----------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
IMAGE_TAG=latest
# 127.0.0.1 keeps every port off the LAN; set 0.0.0.0 only behind a firewall
BIND_ADDR=127.0.0.1
TENANT_ID=default

# ---- PostGIS (asset registry) -----------------------------------------------
POSTGIS_HOST=postgis
POSTGIS_PORT=5432
POSTGIS_DB=dt_assets
POSTGIS_USER=dt_assets
POSTGIS_PASSWORD=CHANGE_ME_postgis
POSTGIS_POOL_MAX=20
POSTGIS_HOST_PORT=5432
POSTGIS_SHARED_BUFFERS=512MB
POSTGIS_EFFECTIVE_CACHE=1536MB

# ---- TimescaleDB (telemetry) ------------------------------------------------
TSDB_HOST=timescaledb
TSDB_PORT=5432
TSDB_DB=dt_telemetry
TSDB_USER=dt_telemetry
TSDB_PASSWORD=CHANGE_ME_tsdb
TSDB_POOL_MAX=20
TSDB_HOST_PORT=5433
TSDB_TUNE_MEMORY=2GB
TSDB_TUNE_CPUS=2
# Raw telemetry retention / compression horizons (used by Phase 2 policies)
TSDB_RETENTION_DAYS=90
TSDB_COMPRESS_AFTER_DAYS=7

# ---- Kafka (KRaft) ----------------------------------------------------------
# Generate once:  docker run --rm apache/kafka:3.8.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_BROKERS=kafka:29092
KAFKA_EXTERNAL_HOST=localhost
KAFKA_HOST_PORT=9092
KAFKA_REPLICATION_FACTOR=1
KAFKA_TELEMETRY_PARTITIONS=12
KAFKA_HEAP_OPTS=-Xms512m -Xmx1g
KAFKA_CLIENT_ID=dt-platform
KAFKA_WORKER_GROUP_ID=dt-telemetry-worker
TOPIC_TELEMETRY_RAW=dt.telemetry.raw
TOPIC_TELEMETRY_ANOMALIES=dt.telemetry.anomalies
TOPIC_DEVICE_STATE=dt.device.state
TOPIC_ASSET_EVENTS=dt.asset.events
TOPIC_IFC_JOBS=dt.ifc.jobs
TOPIC_TELEMETRY_DLQ=dt.telemetry.dlq
KAFKA_UI_HOST_PORT=8080

# ---- MQTT (Mosquitto) -------------------------------------------------------
# Usernames must match infra/mosquitto/acl
MQTT_URL=mqtt://mosquitto:1883
MQTT_SERVICE_USERNAME=dt-service
MQTT_SERVICE_PASSWORD=CHANGE_ME_mqtt_service
MQTT_DEVICE_USERNAME=dt-device
MQTT_DEVICE_PASSWORD=CHANGE_ME_mqtt_device
MQTT_TOPIC_ROOT=dt/v1
# Enable to load-balance multiple ingest-bridge replicas via MQTT shared subscriptions
# MQTT_SHARED_GROUP=dt-ingest
MQTT_HOST_PORT=1883
MQTT_WS_HOST_PORT=9001

# ---- Redis (WS fan-out + live state cache) ----------------------------------
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=CHANGE_ME_redis
REDIS_MAXMEMORY=512mb
REDIS_HOST_PORT=6379
REDIS_STATE_CHANNEL_PREFIX=dt:state

# ---- Migrations ---------------------------------------------------------------
# Loads the demo Abu Dhabi campus (42 assets, BIM schematic, devices, alert rules)
SEED_DEMO_DATA=true

# ---- API (NestJS) -----------------------------------------------------------
API_HOST_PORT=4000
API_INTERNAL_URL=http://api:4000/api/v1
API_GLOBAL_PREFIX=api/v1
WS_PATH=/realtime/socket.io
# Comma-separated; the gateway origin + web origin
CORS_ORIGINS=http://localhost:3000,http://localhost:8082
# Signs platform JWTs (validated again by the Gravitee JWT plan)
JWT_SECRET=CHANGE_ME_jwt_secret_min_32_chars
JWT_ISSUER=dt-platform
JWT_AUDIENCE=dt-platform-clients
JWT_TTL_SECONDS=28800
# Local console users (replace with the customer IdP in production)
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=CHANGE_ME_admin_password
AUTH_VIEWER_USERNAME=viewer
AUTH_VIEWER_PASSWORD=CHANGE_ME_viewer_password
# Development only — bypasses JWT checks entirely
AUTH_DISABLED=false
# IFC uploads — shared volume between api (write) and worker (read)
IFC_STORAGE_DIR=/data/ifc
IFC_MAX_UPLOAD_MB=200

# ---- Telemetry worker -------------------------------------------------------
WORKER_REPLICAS=2
WORKER_BATCH_SIZE=500
WORKER_FLUSH_INTERVAL_MS=1000
# Fallback thresholds when an asset has no per-metric rule in PostGIS
ANOMALY_DEFAULT_TEMP_MAX_C=27
ANOMALY_DEFAULT_RACK_POWER_MAX_KW=8
ANOMALY_ZSCORE_THRESHOLD=3.5
ANOMALY_WINDOW_SIZE=60
STALE_AFTER_MS=60000
IFC_PARSER_ENABLED=true

# ---- Simulator (profile: sim) -----------------------------------------------
# Extra synthetic env sensors on top of the registered devices
SIM_DEVICE_COUNT=0
SIM_PUBLISH_INTERVAL_MS=2000
# Per device, per tick chance of starting a fault episode (warning → critical → recovery)
SIM_ANOMALY_PROBABILITY=0.004

# ---- Gravitee APIM (API gateway) --------------------------------------------
GRAVITEE_VERSION=4.11
GRAVITEE_ES_VERSION=8.15.3
GRAVITEE_MONGO_USER=gravitee
GRAVITEE_MONGO_PASSWORD=CHANGE_ME_gravitee_mongo
GRAVITEE_JWT_SECRET=CHANGE_ME_gravitee_jwt_secret_min_32_chars
GRAVITEE_ADMIN_USER=admin
# Rotate on first login to the Console
GRAVITEE_ADMIN_PASSWORD=admin
GATEWAY_HOST_PORT=8082
GRAVITEE_MGMT_HOST_PORT=8083
GRAVITEE_CONSOLE_HOST_PORT=8084
GRAVITEE_PORTAL_HOST_PORT=8085
GRAVITEE_MGMT_PUBLIC_URL=http://localhost:8083
GRAVITEE_CONSOLE_PUBLIC_URL=http://localhost:8084
GRAVITEE_PORTAL_PUBLIC_URL=http://localhost:8085
# Context paths the API definitions publish on the gateway (Phase 3)
GATEWAY_REST_CONTEXT=/dt/v1
GATEWAY_WS_CONTEXT=/dt/realtime
# gateway-provisioner
GRAVITEE_MGMT_URL=http://gravitee-management-api:8083
API_UPSTREAM_URL=http://api:4000
GRAVITEE_PROVISION_FORCE=false
GRAVITEE_ES_JAVA_OPTS=-Xms512m -Xmx512m
GRAVITEE_GATEWAY_JAVA_OPTS=-Xms256m -Xmx512m
GRAVITEE_MGMT_JAVA_OPTS=-Xms256m -Xmx768m

# ---- Web (Next.js) — baked into the browser bundle at build time ------------
WEB_HOST_PORT=3000
# Browser traffic goes through the gateway, never straight to the API
NEXT_PUBLIC_API_URL=http://localhost:8082/dt/v1
NEXT_PUBLIC_WS_URL=http://localhost:8082/dt/realtime
# Token-free vector basemap; swap for a self-hosted style for sovereign/air-gapped sites
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# lon,lat,zoom — default Abu Dhabi
NEXT_PUBLIC_MAP_CENTER=54.3773,24.4539,15
